        "Enable_Script_for_Every_Step_Update": "False",
        "Every_Step_Update_Script": "-- This is a script that can be used to update particle speed at each\n-- integration step\n--\n-- Created:  \t\t5-21-2002\n-- Last Updated:\t2-18-2003\n--\n-- Author :  Oleg Bayborodin\n-- Version:  3ds max 5.1\n--********************************************************************\n-- MODIFY THIS AT YOUR OWN RISK\n \npf_node_current = particleFlow.scriptRunner() -- current particle system\nif (pf_node_current != undefined) then \n(\n\tcount = pf_node_current.NumParticles()\n\t\n\tfor i in 1 to count do \n\t( \n\t\tpf_node_current.particleIndex = i \n\t\tage = 5*pf_node_current.particleAge \n\t\tpf_node_current.particleSpeed = [0.05*cos(age), 0.05*sin(age), -0.05] \n\t) \n)\n \n",
        "Use_File_for_Every_Step_Update": "False",
        "Every_Step_Update_Script_File": "None",
        "Enable_Script_for_Final_Step_Update": "False",
        "Final_Step_Update_Script": "-- This is a script that can be used to update particle position at final\n-- integration step\n--\n-- Created:  \t\t5-21-2002\n-- Last Updated:\n--\n-- Author :  Oleg Bayborodin\n-- Version:  3ds max 5.1\n--************************************************************************\n-- MODIFY THIS AT YOUR OWN RISK\n \npf_node_current = particleFlow.scriptRunner() -- current particle system\nif (pf_node_current != undefined) then \n(\n\tcount = pf_node_current.NumParticles() \n\t\n\tfor i in 1 to count do\n\t(\n\t\tpf_node_current.particleIndex = i\n\t\tage = 5*pf_node_current.particleAge\n\t\tfactor = 20*(sin(2*age)+1)\n\t\tpf_node_current.particlePosition = [factor*cos(77*i), factor*sin(77*i), -age] + pf_node_current.pos\n\t)\n)\n \n",
        "Use_File_for_Final_Step_Update": "False",
        "Final_Step_Update_Script_File": "None",
